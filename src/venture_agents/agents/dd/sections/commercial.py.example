# ===================================================================
# Build functions
# ===================================================================


async def build_politics(agent: DDAgent, **kwargs: object) -> tuple[str, list[str]]:
    """构建 7.1 国家/地区政治与经济背景。"""

    main_idea = (
        "Analyze the maturity and stability of the mining regulatory environment, "
        "foreign ownership restrictions, national security or resource nationalism "
        "risks, investment treaty protections, and precedent of international "
        "miners operating in the region of xxx owned by yyy. "
        "Identify macro-level risk factors affecting investment."
    )

    return "ttt", []


async def build_esg(agent: DDAgent, **kwargs: object) -> tuple[str, list[str]]:
    """构建 7.2 ESG、社区与社会影响。"""

    main_idea = (
        "Assess community relationships, social license to operate, land acquisition "
        "and resettlement issues, labor practices, carbon footprint and energy use, "
        "and governance transparency of xxx owned by yyy. Evaluate whether "
        "ESG factors may affect operational continuity or project approval timelines."
    )

    return "ttt", []


async def build_hr(agent: DDAgent, **kwargs: object) -> tuple[str, list[str]]:
    """构建 7.3 人力资源。"""
    main_idea = (
        "Describe the workforce size of xxx owned by yyy and the "
        "composition, local vs. expatriate labor distribution, and experience of "
        "corporate and site leadership teams. Evaluate whether organizational "
        "capability supports reliable operations."
    )

    return "ttt", []


