# Section 注册
# ===================================================================

SECTION_DEF: list[Section] = [
    Section(
        meta=SectionMeta(
            name="commercial",
            title=_PARENT_TITLE_LIST,
            phase="primary",
            order=[7],
        ),
        build=build_noop,
    ),
    Section(
        meta=SectionMeta(
            name="politics",
            title=_TITLE_71,
            phase="primary",
            order=[7, 1],
        ),
        build=build_politics,
    ),
    Section(
        meta=SectionMeta(
            name="esg",
            title=_TITLE_72,
            phase="primary",
            order=[7, 2],
        ),
        build=build_esg,
    ),
    Section(
        meta=SectionMeta(
            name="hr",
            title=_TITLE_73,
            phase="primary",
            order=[7, 3],
        ),
        build=build_hr,
    ),
]
